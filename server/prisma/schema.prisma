generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
  VOID
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(CUSTOMER)
  customer  Customer?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([role])
}

model Customer {
  id            String         @id @default(cuid())
  userId        String?        @unique
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyName   String
  phone         String?
  address       String?
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([companyName])
}

model Product {
  id                String             @id @default(cuid())
  name              String
  type              String
  salesPrice        Float
  costPrice         Float              @default(0)
  notes             String?
  variants          ProductVariant[]
  subscriptionLines SubscriptionLine[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([name])
}

model ProductVariant {
  id                String             @id @default(cuid())
  productId         String
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute         String
  value             String
  additionalPrice   Float              @default(0)
  subscriptionLines SubscriptionLine[]
  createdAt         DateTime           @default(now())

  @@unique([productId, attribute, value])
  @@index([productId])
}

model Plan {
  id                String         @id @default(cuid())
  name              String
  price             Float
  billingInterval   String
  minimumQuantity   Int            @default(1)
  availableFrom     DateTime?
  availableUntil    DateTime?
  autoClose         Boolean        @default(false)
  lifecycleSettings String?
  subscriptions     Subscription[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([name])
}

model Subscription {
  id                 String             @id @default(cuid())
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptionNumber String             @unique
  startDate          DateTime
  expiryDate         DateTime?
  nextBillingDate    DateTime?
  status             SubscriptionStatus @default(ACTIVE)
  quantity           Int                @default(1)
  unitPrice          Float              @default(0)
  billingInterval    String             @default("Monthly")
  taxRate            Float              @default(0)
  billingAnchorDay   Int                @default(1)
  lines              SubscriptionLine[]
  invoices           Invoice[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([customerId, status])
  @@index([planId])
  @@index([nextBillingDate])
}

model Invoice {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invoiceNumber  String          @unique
  periodStart    DateTime
  periodEnd      DateTime
  issueDate      DateTime        @default(now())
  dueDate        DateTime
  status         InvoiceStatus   @default(OPEN)
  subtotal       Float
  taxRate        Float           @default(0)
  taxAmount      Float           @default(0)
  total          Float
  amountPaid     Float           @default(0)
  lines          InvoiceLine[]
  payments       Payment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([subscriptionId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  lineTotal   Float

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Float
  method      String
  reference   String?
  paidAt      DateTime @default(now())
  recordedBy  String
  createdAt   DateTime @default(now())

  @@index([invoiceId, paidAt])
}

model SubscriptionLine {
  id             String         @id @default(cuid())
  subscriptionId String
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int            @default(1)
  unitPrice      Float

  @@index([subscriptionId])
  @@index([productId])
}
